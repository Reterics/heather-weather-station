HEATHER_HOST=0.0.0.0
HEATHER_PORT=8080
HEATHER_LOG_LEVEL=info
HEATHER_GRID_DECIMALS=2
HEATHER_CACHE_TTL_SECONDS=600
HEATHER_CACHE_STALE_SECONDS=21600
HEATHER_CACHE_MAX_ENTRIES=2000
HEATHER_UPSTREAM_TIMEOUT_SECONDS=8
HEATHER_UPSTREAM_RETRIES=1
HEATHER_RETRY_BACKOFF_SECONDS=0.4
HEATHER_RATE_LIMIT_PER_MINUTE=60
HEATHER_TRUST_PROXY=false
HEATHER_OPENMETEO_BASE_URL=https://api.open-meteo.com
# Server-side only. Required for commercial use of the Open-Meteo customer API.
HEATHER_OPENMETEO_API_KEY=
# Comma-separated browser origins. Leave empty when the dashboard is served here.
HEATHER_CORS_ORIGINS=
